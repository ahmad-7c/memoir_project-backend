# ---------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT -- backend, AWS ECS Fargate
#
# Copy to `.env.production`, fill in, and load into the task definition's
# secrets. Do NOT commit the filled-in copy; `.dockerignore` and `.gitignore` both
# exclude it, but a secret in a git remote is not undone by a gitignore entry.
#
# For ECS, every value below belongs in Secrets Manager (or SSM SecureString),
# referenced from the task definition -- not in a plain environment variable in
# the console. The service-role key bypasses RLS, so it is the single most
# damaging value in this file.
# ---------------------------------------------------------------------------

# === Supabase ==============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres, not the pooled transaction port. Alembic needs a session that
# can run DDL, and the pooler on 6543 does not guarantee that. 5432 is correct.
#
# If your pooler sits behind the Supabase project password rather than the
# database password, the credentials differ -- verify before a deploy, not during
# one. This URL is the thing most likely to be wrong on a first attempt.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_NAME=media
MEDIA_MAX_BYTES=52428800
# Signed media URLs are bearer credentials. Keep the TTL short.
MEDIA_SIGNED_URL_TTL=300

# === AI providers ==========================================================
# The process REFUSES TO BOOT if the LLM chain is empty (groq AND gemini unset)
# or ASSEMBLYAI_API_KEY is missing. That is intended: a missing key must fail at
# deploy time, not on the first click of "Organize" hours later.
GROQ_API_KEY=
GROQ_ORGANIZE_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS_PER_PROVIDER=2
AI_MAX_CONCURRENCY=4
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
ORGANIZE_PIPELINE_DEADLINE_SECONDS=180

# === Reader share links ====================================================
# The full public base including /contribute -- matches the frontend's actual
# reader route (frontend/src/app/contribute/[token]); there is no /share page.
# This is what gets pasted into emails, so it is user-visible in the wrong way
# if left as localhost or pointed at a route that doesn't exist.
SHARE_LINK_BASE_URL=https://your-vercel-domain.vercel.app/contribute

# === Browser delivery (READ THIS) ==========================================
# The frontend is on Vercel and the backend is on AWS: different registrable
# domains, therefore genuinely cross-site. Two settings follow from that.
#
#   COOKIE_SAMESITE=none   cross-site cookie must be sent by the browser
#   COOKIE_SECURE=true     https only -- REQUIRED, browsers drop the cookie otherwise
#
# The backend now refuses to boot if SAMESITE=none without SECURE=true. That
# combination logs every user out instantly and every response looks like an
# unrelated auth bug.
#
# COOKIE_SECURE=false / COOKIE_SAMESITE=lax are the local-development values and
# are correct only for http://localhost.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Explicit origins. A wildcard is rejected at boot: authentication is a
# credentialed httpOnly cookie, and browsers reject credentialed responses that
# carry `Access-Control-Allow-Origin: *`.
#
# List every origin that will call this API, including Vercel preview
# deployments if you want them. Note there is no trailing slash.
CORS_ORIGINS=https://your-vercel-domain.vercel.app,https://www.your-domain.com

# === Reader token signing ==================================================
# MUST be different on every environment. A shared value means a share token
# minted in staging verifies in production, and vice versa.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every live share link, so do it deliberately.
READER_JWT_SECRET=

# === Runtime ===============================================================
WEB_CONCURRENCY=2