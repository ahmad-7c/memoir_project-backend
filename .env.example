# Supabase Core Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Connection (PostgreSQL / SQLAlchemy)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Authentication & Storage Settings
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_NAME=media
MEDIA_MAX_BYTES=52428800
MEDIA_SIGNED_URL_TTL=300

# ---------------------------------------------------------------------------
# AI provider chains
#
# The app refuses to boot if a required capability has zero usable providers
# (see validate_ai_provider_chain in src/core/config.py), so a missing key is a
# startup crash rather than a confusing 500 on someone's request later.
# ---------------------------------------------------------------------------

# LLM PRIMARY: Groq. Supports Structured Outputs in strict mode, so the JSON
# shape of a model response is guaranteed by constrained decoding rather than
# merely requested. Leave GROQ_API_KEY unset to run on Gemini alone.
GROQ_API_KEY=
GROQ_ORGANIZE_MODEL=openai/gpt-oss-120b

# LLM FALLBACK: Gemini, via the OpenAI-compatible endpoint. Already integrated,
# so a Groq outage costs latency and money rather than taking the feature down.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# STT PRIMARY: AssemblyAI.
ASSEMBLYAI_API_KEY=

# STT FALLBACK: Deepgram. Deliberately not Groq/Whisper -- Whisper hallucinates
# text during silence and music, and fabricated sentences in a dead relative's
# recording is worse than a transcription outage. Deepgram is also faster and
# cheaper per hour.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Per-attempt timeout for any AI provider call. Keep bounded: with a single
# worker pool, a hung upstream pins a thread for this long on every request.
AI_REQUEST_TIMEOUT_SECONDS=30

# Attempts against ONE provider before failing over to the next.
AI_MAX_ATTEMPTS_PER_PROVIDER=2

# Max concurrent agent calls. Providers rate-limit on requests/tokens per
# minute, so an unbounded fan-out is a self-inflicted 429.
AI_MAX_CONCURRENCY=4

# Circuit breaker. After this many consecutive failures a provider is skipped
# for the cooldown, so a dead provider stops costing a full timeout on every
# subsequent request.
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60

# Wall-clock ceiling for one full organize pipeline. Past this the job is a bug
# or a pathological memoir, not a slow success.
ORGANIZE_PIPELINE_DEADLINE_SECONDS=180

# Secret for signing short-lived reader (name+password) tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the Supabase JWT secret here.
READER_JWT_SECRET=change-me-to-a-long-random-secret

# Base URL the frontend uses to build shareable memoir links, e.g. https://app.example.com/share
SHARE_LINK_BASE_URL=http://localhost:3000/contribute

# httpOnly access-token cookie flags. Leave both at their defaults for local
# dev (http://localhost). In a real deployment: COOKIE_SECURE=true always
# (cookie requires https); COOKIE_SAMESITE=none only if the frontend and
# backend end up on genuinely different domains, not just different ports.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax